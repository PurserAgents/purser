{
  "name": "@purser/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Purser: a bank account for your AI agent on Robinhood Chain.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/schema.d.ts", "default": "./dist/schema.js" },
    "./merchant": { "types": "./dist/merchant.d.ts", "default": "./dist/merchant.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "viem": "2.57.18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
